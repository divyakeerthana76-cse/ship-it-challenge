# Ship It Challenge - Dockerfile Template
# 
# YOUR TASK: Create a Dockerfile for the Ship It challenge app
#
# Requirements:
# - Use Node.js as base image
# - Set WORKDIR
# - Copy package files and install dependencies
# - Copy application source
# - Expose port 3000
# - Set CMD to start the application
#
# DO NOT copy this file directly - create your own from scratch!
#
# Example structure (fill in the details yourself):
#
# FROM node:20-alpine
# WORKDIR /app
# COPY package*.json ./
# RUN npm install
# COPY src ./src
# ENV PORT=3000
# EXPOSE 3000
# CMD ["node", "src/index.js"]
